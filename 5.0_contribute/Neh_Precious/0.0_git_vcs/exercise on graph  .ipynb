      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "y=func(x)\n",
    "plt.plot(x, y, color='navy', linewidth=2)\n",
    "plt.title(\"graph of y against x\")\n",
    "plt.xlabel('x')\n",
    "plt.ylabel('y')\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
  }
