    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "x=np.array([1,2,4,4])\n",
    "def func(x):\n",
    "    return(x**3)+1\n",
    "func(x)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
